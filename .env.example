# tushlik-bot settings. Copy to .env and fill in:  cp .env.example .env
# .env is in .gitignore — never commit it (token, card, password).

# --- required ---------------------------------------------------------------

# Bot token from @BotFather (/newbot).
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Password for the bot's own Postgres in docker-compose. Any long random string:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Your Telegram user id (not @username). Donations come to you for confirmation.
# How to find it: write to @userinfobot, it replies with your id.
OWNER_ID=123456789

# Card for donations (shown only in private chats with donors) and the name on it.
OWNER_CARD=8600 0000 0000 0000
OWNER_CARD_HOLDER=Ism Familiya

# Group id is not needed: add the bot to any group and it remembers the group itself.

# --- money (optional, defaults shown) -------------------------------------------

# Label after amounts.
CURRENCY=сум
# Every share is rounded UP to this step, so the payer never loses on rounding.
ROUND_TO=100

# Monthly server goal = SERVER_COST_USD + SERVER_TAX_PERCENT %, shown in CURRENCY at USD_RATE.
# Default: $10 + 12% = $11.20 × 12800 = 143 360 сум.
SERVER_COST_USD=10
SERVER_TAX_PERCENT=12
USD_RATE=12800

# --- other (optional) -------------------------------------------------------------

# Link shown in /about.
REPO_URL=https://github.com/Abdukhalil-zoda/tushlik-bot
# Time zone for reminders ("tomorrow 10:00") and month boundaries.
TZ=Asia/Tashkent
